{
  "name": "tb-electrical-herts-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "next build --webpack",
    "build:cloudflare": "vinext build",
    "start": "next start",
    "deploy": "vinext-cloudflare deploy",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "prebuild": "node scripts/check-security-versions.mjs",
    "security:check": "node scripts/check-security-versions.mjs",
    "security:audit": "pnpm audit"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.0.0-beta.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.1.6",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "ws": "8.21.0",
    "esbuild": "0.28.2",
    "undici": "7.30.1",
    "sharp": "0.35.5",
    "image-size": "2.0.3",
    "satori": "0.33.5",
    "fast-uri@^3.0.0": "3.1.9",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^5.0.0": "5.0.12",
    "source-map-js@^1.0.0": "1.2.2",
    "zod@^4.0.0": "4.6.6",
    "@vercel/og": "1.0.3",
    "fflate": "0.8.3"
  },
  "packageManager": "pnpm@11.25.0"
}
